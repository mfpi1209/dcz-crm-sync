# Ambiente LOCAL de teste do Motor de Ativações (scripts/motor_local.py).
# `preparar` copia este arquivo para .motor-local/env, que não é versionado.
# Banco, simulação e porta NÃO se configuram aqui: o script fixa o Postgres local
# (127.0.0.1), MOTOR_ENABLED=1 e MOTOR_DRY_RUN=1. Só as chaves abaixo são lidas.

# Pasta com os arquivos rodada_AAAA-MM-DD.json da reprise (padrão: .motor-local/rodadas).
# MOTOR_REPRISE_DIR=

# Opcional: leitura do CRM ao vivo, só GET (fila e negócios). Token de teste, de papel mínimo.
# Sem ele o motor local roda só com a reprise. Nunca commitar.
# EDUIT_CRM_TOKEN=
# EDUIT_CRM_BASE_URL=https://integrations.bwipo.com

# Opcional: feriados extras (AAAA-MM-DD separados por vírgula).
# MOTOR_FERIADOS=
