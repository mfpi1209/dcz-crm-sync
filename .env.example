# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_NAME=dcz_sync
# Banco eduit (mesmo host/user/senha) — Matérias dos Alunos grava em public.materias_alunos
EDUIT_PG_DB=eduit

# Kommo CRM (sync comercial)
KOMMO_TOKEN=
KOMMO_BASE_URL=https://seu-subdominio.kommo.com
# Desempenho: incremental no dia a dia; full sync só fora do horário
KOMMO_BATCH_SIZE=100
KOMMO_SLEEP_PAGES=0
KOMMO_DELTA_LOOKBACK_DAYS=1
KOMMO_DUAL_WRITE_PG=1
# Kommo desativado: o espelho kommo_sync no Postgres continua sendo o histórico.
# 1 religa os jobs que chamam a API do Kommo (aceites a cada 10 min, histórico às 04:30).
KOMMO_API_JOBS=0
# Cópia indexada da vw_leads_rgm (mv_leads_rgm). 0 = cria uma vez, sem refresh periódico.
LEADS_RGM_REFRESH_MIN=0
# Só com refresh periódico: depois disso sem refresh bem-sucedido, volta para a view.
LEADS_RGM_MAX_AGE_MIN=180

# CRM API
DATACRAZY_API_TOKEN=dc_seu_token_aqui

# Supabase REST API (db_agente_comercial_csv) — atividade Kommo dos consultores
# Usado pelo Dashboard Comercial para consultar public.kommo_consultor_atividade_dia
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sb_secret_seu_service_role_aqui

# Supabase Acadêmico (projeto separado) — tabela academico_interacoes
# Usado pela página Acadêmico → Interações Acadêmicas
SUPABASE_ACADEMICO_URL=https://seu-projeto-academico.supabase.co
SUPABASE_ACADEMICO_KEY=sb_secret_seu_service_role_aqui

# Supabase Inscrições — tabela public.inscricoes_logs (página Comercial → Inscrições)
SUPABASE_INSCRICOES_URL=https://seu-projeto-inscricoes.supabase.co
SUPABASE_INSCRICOES_KEY=sb_secret_seu_service_role_aqui

# CRM EduIT (org Cruzeiro EaD) — clique no telefone em Interações Acadêmicas
# atribui o lead ao operador logado no painel e abre o funil.
# Token: Configurações → Tokens de API no CRM (prefixo eduit_).
EDUIT_CRM_TOKEN=
EDUIT_CRM_BASE_URL=https://crm.eduit.com.br
EDUIT_CRM_WEB_URL=https://frontend-front.v74knz.easypanel.host

# CRM comercial Bwipo (org Comercial Cruzeiro) — Sync Bwipo / dashboard comercial.
# NÃO usar o token do CRM acadêmico (cruzeiro-ead / Disparador).
BWIPO_COMERCIAL_API_BASE_URL=https://integrations.bwipo.com
BWIPO_COMERCIAL_API_TOKEN=
BWIPO_COMERCIAL_WEB_URL=https://comercialcruzeiro.bwipo.com
BWIPO_COMERCIAL_PAGE_SLEEP=0.45
# Incremental: folga (s) e teto de dias desde o last_sync (0 = sem teto).
BWIPO_DELTA_SLACK_S=300
BWIPO_DELTA_LOOKBACK_DAYS=7

# CRM comercial Bwipo (Upload Comercial). Default continua Kommo.
# BWIPO_CRM_TOKEN=
# BWIPO_CRM_BASE_URL=https://integrations.bwipo.com
# Só local: mostra o seletor "Novo CRM" na aba Upload Comercial.
# MM_ALLOW_BWIPO_UI=1
# Override global (evite em produção; o seletor da UI já escolhe o destino).
# UPLOAD_COMERCIAL_CRM=bwipo

# Disparador WhatsApp (página Acadêmico → Disparador WhatsApp)
# Proxy Flask para o app tool_whatsapp_alunos hospedado lado a lado.
# Default aponta para o Easypanel de produção; sobrescreva apenas em dev.
# URL do app externo tool_whatsapp_alunos (Disparador + Rematrícula embed).
# Produção: Easypanel. Para dev local do tool, use http://localhost:5173
# (exige `npm run dev` no repo tool_whatsapp_alunos rodando).
WHATSAPP_TOOL_BASE_URL=https://banco-disparador-whatsapp.6tqx2r.easypanel.host
# APP_API_KEY do app externo (opcional). Se setado, é injetado como
# x-api-key e Authorization: Bearer nas chamadas /api/disparador_whatsapp/*.
WHATSAPP_TOOL_API_KEY=
# Timeout (em segundos) das chamadas ao app externo.
WHATSAPP_TOOL_TIMEOUT_S=30

# Motor de Ativações (worker: python -m motor.worker, em serviço separado).
# Sobe desligado e em simulação. Envio real exige as quatro chaves juntas:
# MOTOR_ENABLED=1, MOTOR_DRY_RUN=0, motor ligado na página e plano do dia aprovado.
MOTOR_ENABLED=0
MOTOR_DRY_RUN=1
# API pública do CRM acadêmico (única que aceita Bearer). Usa EDUIT_CRM_TOKEN.
# MOTOR_CRM_BASE_URL=https://integrations.bwipo.com
# Orçamento de chamadas por minuto (teto de 60 em código) e reserva para fila, resultado e pausa.
# MOTOR_CRM_RPM=60
# MOTOR_CRM_RESERVA_ALTA=10
# Funil dos alunos (vazio = todos) e nomes dos campos do negócio no CRM.
# MOTOR_PIPELINE_ID=
# MOTOR_CAMPO_DIA10=dia
# MOTOR_CAMPO_FINANCEIRA=situacaofinanceira
# MOTOR_CAMPO_SITUACAO=situacao
# MOTOR_CAMPO_CALOURO=calouro
# MOTOR_CAMPO_NIVEL=nivel
# Só entra quem tem o campo nível igual a este valor (sem acento, espaço nem maiúsculas). Vazio = todos.
# MOTOR_NIVEL_ALVO=graduacao
# Etiquetas extras que tiram o aluno dos envios (separadas por vírgula). "Sem lembretes de
# mensalidade" e "Sem mensagens automáticas" já valem sempre.
# MOTOR_TAGS_BLOQUEIO=
# Limites (só apertam; os tetos absolutos ficam em motor/config.py).
# MOTOR_JANELA_INICIO_H=9
# Fim do expediente (teto de 22h em código) e corte: o último lote sai MOTOR_CORTE_MIN antes do fim,
# e nunca depois das 21h.
# MOTOR_JANELA_FIM_H=22
# MOTOR_CORTE_MIN=60
# MOTOR_TETO_DIARIO=4000
# MOTOR_LOTE_MAX=1200
# MOTOR_LOTE_MIN=200
# MOTOR_RAMPA=300,600
# MOTOR_DIAS_ANTES_VENCIMENTO=3
# Fila: quanto ela pode subir desde o último lote antes de segurar o próximo e de pausar o que está enviando
# (tetos de 30 e 60 em código), e por quantos minutos o nível do lote ainda vale.
# MOTOR_FILA_SOBE_SEGURA=30
# MOTOR_FILA_SOBE_PAUSA=60
# MOTOR_FILA_BASE_VALIDADE_MIN=120
# MOTOR_ATENDENTES_MIN=5
# MOTOR_ATEND_POR_HORA=6
# MOTOR_BASE_CONVERSAS_HORA=28
# MOTOR_HUMANOS_POR_ENVIO=0.025
# MOTOR_EXP_SEGURA_POR_MIL=8
# MOTOR_EXP_ENCERRA_POR_MIL=15
# MOTOR_EXP_MIN_CASOS=5
# MOTOR_CONTROLE_PCT=5
# MOTOR_CARGA_MIN_ABERTOS=8000
# MOTOR_TICK_S=30
# Feriados extras (AAAA-MM-DD separados por vírgula; os nacionais já estão no código).
# MOTOR_FERIADOS=
# Só em simulação: fila hipotética "aguardando,atendentes" quando a fila real não responde.
# MOTOR_SIM_FILA=45,10
# Envio real (worker): canal do WhatsApp e template de cada mensagem. Sem os dois o lote não sai.
# MOTOR_CANAL_ID=
# MOTOR_TEMPLATE_LEMBRETE_DIA25=motor_lembrete_dia25_a
# MOTOR_TEMPLATE_IDIOMA=pt_BR
# MOTOR_VELOCIDADE=1
# Classificação das respostas pelo Jev (worker). Sem a chave valem as regras por palavra-chave.
# TYPESAFE_API_KEY=
# MOTOR_JEV_MODELO=jev-latest
# Guardar o texto mascarado da resposta por até 30 dias (decisão D6; desligado).
# MOTOR_GUARDAR_TEXTO=0
# Receptor de respostas (painel): segredo do webhook message_received criado no CRM,
# organização esperada e modo de observação (grava respostas mesmo sem envio do motor).
# MOTOR_WEBHOOK_SECRET=
# MOTOR_CRM_ORG_ID=
# MOTOR_RESPOSTAS_OBSERVAR=0
